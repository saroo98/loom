{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/release-rollback-evidence.schema.json",
  "title": "Bounded Loom release rollback evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "commit", "public_root_sha256",
    "tests", "transcript_sha256", "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["passed", "failed"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "public_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^test_[A-Za-z0-9_]+\\.py$"}
    },
    "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
