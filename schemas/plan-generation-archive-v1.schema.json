{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/plan-generation-archive-v1.schema.json",
  "title": "Loom immutable private plan-generation archive",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "generation_id", "terminal_phase", "active_index_sha256", "lifecycle_sha256", "plan_semantics_sha256", "tree_sha256", "tree_manifest", "files", "archive_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/id"},
    "generation_id": {"$ref": "#/$defs/id"},
    "terminal_phase": {"enum": ["terminal-completed", "terminal-cancelled", "terminal-superseded", "terminal-quarantined"]},
    "active_index_sha256": {"$ref": "#/$defs/sha256"},
    "lifecycle_sha256": {"$ref": "#/$defs/sha256"},
    "plan_semantics_sha256": {"$ref": "#/$defs/sha256"},
    "tree_sha256": {"$ref": "#/$defs/sha256"},
    "tree_manifest": {"$ref": "#/$defs/exactTreeManifest"},
    "files": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "content_base64"], "properties": {"path": {"$ref": "#/$defs/treePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0, "maximum": 4194304}, "content_base64": {"type": "string", "maxLength": 5592408}}}},
    "archive_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "treePath": {"type": "string", "pattern": "^(?:\\.|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$", "maxLength": 512},
    "exactTreeDirectory": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "mode"],
      "properties": {"path": {"$ref": "#/$defs/treePath"}, "kind": {"const": "directory"}, "mode": {"type": "integer", "minimum": 0, "maximum": 4095}}
    },
    "exactTreeFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "mode", "bytes", "sha256", "links"],
      "properties": {"path": {"$ref": "#/$defs/treePath"}, "kind": {"const": "file"}, "mode": {"type": "integer", "minimum": 0, "maximum": 4095}, "bytes": {"type": "integer", "minimum": 0, "maximum": 4194304}, "sha256": {"$ref": "#/$defs/sha256"}, "links": {"const": 1}}
    },
    "exactTreeManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "policy", "platform", "entries", "file_count", "directory_count", "total_bytes", "root_sha256"],
      "properties": {
        "schema_version": {"const": 2},
        "policy": {"const": "exact-tree-no-extended-data-v1"},
        "platform": {"enum": ["windows", "posix"]},
        "entries": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"oneOf": [{"$ref": "#/$defs/exactTreeDirectory"}, {"$ref": "#/$defs/exactTreeFile"}]}},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 512},
        "directory_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "root_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
