{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/release-qualification-timing-profile-v2.schema.json",
  "title": "Fixed mechanism qualification timing profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload_kind",
    "default_p75_microseconds",
    "module_microseconds",
    "profile_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "workload_kind": {"const": "mechanism-v2"},
    "default_p75_microseconds": {"type": "integer", "minimum": 1, "maximum": 3600000000},
    "module_microseconds": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "patternProperties": {
        "^test_qual_[A-Za-z0-9_]+$": {"type": "integer", "minimum": 1, "maximum": 3600000000}
      },
      "additionalProperties": false
    },
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
