{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/release-candidate-rebinding-v2.schema.json",
  "title": "Byte-identical merge candidate admission rebinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "evidence_domain", "source_commit",
    "repository_source_tree_sha256", "public_root_sha256",
    "public_manifest_sha256", "public_file_count",
    "reviewed_candidate_admission", "candidate_equivalence",
    "native_evidence", "native_subjects", "candidate_admission_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"const": "admitted"},
    "evidence_domain": {"const": "candidate-rebinding-v2"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "repository_source_tree_sha256": {"$ref": "#/$defs/digest"},
    "public_root_sha256": {"$ref": "#/$defs/digest"},
    "public_manifest_sha256": {"$ref": "#/$defs/digest"},
    "public_file_count": {"type": "integer", "minimum": 1, "maximum": 8192},
    "reviewed_candidate_admission": {
      "$ref": "release-candidate-admission-v2.schema.json"
    },
    "candidate_equivalence": {
      "$ref": "release-candidate-equivalence-v2.schema.json"
    },
    "native_evidence": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "$ref": "release-candidate-admission-v2.schema.json#/$defs/nativeEvidence"
      }
    },
    "native_subjects": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "$ref": "release-candidate-admission-v2.schema.json#/$defs/nativeSubject"
      }
    },
    "candidate_admission_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
