{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/expected-subject-set.schema.json",
  "title": "Stable-controller or CI expected Loom subjects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "expectation_id", "issuer_kind", "issuer_id",
    "repository", "run_id", "job_id", "workflow_digest", "base_commit",
    "candidate_commit", "issued_at", "expires_at", "evaluation_epoch",
    "subjects", "authority", "expectation_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "expectation_id": {"type": "string", "format": "uuid"},
    "issuer_kind": {"enum": ["stable-controller", "ci"]},
    "issuer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"},
    "repository": {"const": "https://github.com/saroo98/loom"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$"
    },
    "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_commit": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "evaluation_epoch": {"type": "string", "format": "date-time"},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "subject-identity.schema.json"}
    },
    "authority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key_id", "public_key", "signature"],
          "properties": {
            "kind": {"const": "stable-controller-ed25519"},
            "key_id": {"type": "string", "minLength": 1, "maxLength": 64},
            "public_key": {"type": "string", "minLength": 44, "maxLength": 44},
            "signature": {"type": "string", "minLength": 88, "maxLength": 88}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "attestation_sha256"],
          "properties": {
            "kind": {"const": "ci-attestation"},
            "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "expectation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"issuer_kind": {"const": "ci"}},
        "required": ["issuer_kind"]
      },
      "then": {
        "properties": {
          "candidate_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  ]
}
