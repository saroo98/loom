{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/compiled-verification-recipe.schema.json",
  "title": "Loom closed compiled verification recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "registry_id", "registry_sha256", "subject_state_sha256",
    "risk", "steps", "unsupported", "implementation_authorized",
    "execution_isolation", "recipe_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "loom-verification-recipes-v1"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "subject_state_sha256": {"$ref": "#/$defs/sha256"},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "steps": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/step"}
    },
    "unsupported": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/unsupported"}
    },
    "implementation_authorized": {"const": false},
    "execution_isolation": {"const": "disposable-target-snapshot"},
    "recipe_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sections": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id", "sections", "template_id", "target", "outcome_class", "medium",
        "command", "timeout_seconds", "evidence_parser", "failure_meaning",
        "authority", "authority_sha256"
      ],
      "properties": {
        "step_id": {"type": "string", "pattern": "^VS-[0-9]{3}$"},
        "sections": {"$ref": "#/$defs/sections"},
        "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
        "target": {"type": "string", "minLength": 1, "maxLength": 512},
        "outcome_class": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
        "medium": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "command": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "evidence_parser": {"const": "exit-code-zero-v1"},
        "failure_meaning": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
        "authority": {"enum": ["approved-template", "current-project-authority"]},
        "authority_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "template_id", "reason_code"],
      "properties": {
        "section": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "template_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason_code": {
          "enum": [
            "authority-missing", "target-invalid", "template-unsupported",
            "tool-unavailable"
          ]
        }
      }
    }
  }
}
