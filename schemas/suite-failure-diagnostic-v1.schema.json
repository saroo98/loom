{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/suite-failure-diagnostic-v1.schema.json",
  "title": "Closed privacy-safe release-suite failure diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_receipt_sha256", "shard_id", "failures", "failure_diagnostic_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "worker_receipt_sha256": {"$ref": "#/$defs/digest"},
    "shard_id": {"type": "string", "pattern": "^(exclusive|general-[0-9]{3})$"},
    "failures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/failure"}
    },
    "failure_diagnostic_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "status", "exception_type"],
      "properties": {
        "test": {"type": "string", "minLength": 3, "maxLength": 512},
        "status": {"enum": ["failed", "error"]},
        "exception_type": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "error_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
      }
    }
  }
}
