{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/suite-failure-diagnostic-v1.schema.json",
  "title": "Closed privacy-safe release-suite failure diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_receipt_sha256", "shard_id", "failures", "failure_diagnostic_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "worker_receipt_sha256": {"$ref": "#/$defs/digest"},
    "shard_id": {"type": "string", "pattern": "^(exclusive|general-[0-9]{3})$"},
    "failures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/failure"}
    },
    "failure_diagnostic_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "status", "exception_type"],
      "properties": {
        "test": {"type": "string", "minLength": 3, "maxLength": 512},
        "status": {"enum": ["failed", "error"]},
        "exception_type": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "error_code": {"enum": ["HOST_UNVERIFIED", "LIFECYCLE_VERIFICATION_COMMAND_NONZERO", "LIFECYCLE_VERIFICATION_CONTAINMENT_FAILED", "LIFECYCLE_VERIFICATION_SNAPSHOT_FAILED", "LIFECYCLE_VERIFICATION_SNAPSHOT_MUTATION", "LIFECYCLE_VERIFICATION_START_FAILED", "LIFECYCLE_VERIFICATION_TIMEOUT", "LIFECYCLE_VERIFICATION_TRANSCRIPT_ENCODING", "LIFECYCLE_VERIFICATION_TRANSCRIPT_LIMIT", "LIFECYCLE_VERIFICATION_WORLD_MUTATION", "NATIVE_HELPER_BUILD_CANCELLED", "NATIVE_HELPER_BUILD_CONTAINMENT_FAILURE", "NATIVE_HELPER_BUILD_NONZERO", "NATIVE_HELPER_BUILD_OUTPUT_MISSING", "NATIVE_HELPER_BUILD_SOURCE_MUTATION", "NATIVE_HELPER_BUILD_START_FAILED", "NATIVE_HELPER_BUILD_SURVIVOR", "NATIVE_HELPER_BUILD_TIMEOUT", "NATIVE_HELPER_BUILD_TRANSCRIPT_LIMIT", "NATIVE_HELPER_CACHE_LOCK_FAILED", "NATIVE_HELPER_CACHE_ROOT_INVALID", "NATIVE_HELPER_PUBLISH_FAILED", "NATIVE_HELPER_RUSTC_IDENTITY_FAILED", "NATIVE_HELPER_RUSTC_IDENTITY_TIMEOUT", "NATIVE_HELPER_SOURCE_INCOMPLETE", "NATIVE_HELPER_TARGET_RESET_FAILED", "PUBLIC_ERROR_CODE_REDACTED", "SUITE_INVENTORY_CLEANUP_FAILED", "SUITE_INVENTORY_CONTAINMENT_FAILED", "SUITE_INVENTORY_CONTEXT_INVALID", "SUITE_INVENTORY_DISCOVERY_FAILED", "SUITE_INVENTORY_IDENTITY_INVALID", "SUITE_INVENTORY_INPUT_INVALID", "SUITE_INVENTORY_MUTATION", "SUITE_INVENTORY_PRIVACY_FAILED", "SUITE_INVENTORY_PROTECTED_ROOT_INVALID", "SUITE_INVENTORY_REDIRECTED_ROOT", "SUITE_INVENTORY_RUNTIME_CLEANUP_FAILED", "SUITE_INVENTORY_TEST_ROOT_INVALID"]}
      }
    }
  }
}
