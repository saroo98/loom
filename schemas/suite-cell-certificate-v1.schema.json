{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/suite-cell-certificate-v1.schema.json",
  "title": "Complete exact-environment release-suite cell certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "subject", "environment", "environment_sha256", "inventory_sha256", "harness_sha256", "policy_sha256", "timing_profile_sha256", "plan_sha256", "worker_receipts", "execution_microseconds", "outcomes", "outcomes_sha256", "test_count", "passed_count", "failure_count", "error_count", "skip_count", "cell_certificate_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "certified"},
    "subject": {"$ref": "#/$defs/subject"},
    "environment": {"$ref": "#/$defs/environment"},
    "environment_sha256": {"$ref": "#/$defs/digest"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "harness_sha256": {"$ref": "#/$defs/digest"},
    "policy_sha256": {"$ref": "#/$defs/digest"},
    "timing_profile_sha256": {"$ref": "#/$defs/digest"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "worker_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["shard_id", "worker_receipt_sha256", "duration_microseconds"], "properties": {"shard_id": {"type": "string", "pattern": "^(exclusive|general-[0-9]{3})$"}, "worker_receipt_sha256": {"$ref": "#/$defs/digest"}, "duration_microseconds": {"type": "integer", "minimum": 0}}}},
    "execution_microseconds": {"type": "integer", "minimum": 0},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["test", "status"], "properties": {"test": {"type": "string", "minLength": 3, "maxLength": 512}, "status": {"enum": ["passed", "skipped"]}, "skip_reason_code": {"enum": ["platform-boundary", "host-capability-unavailable", "tool-unavailable"]}, "skip_reason_sha256": {"$ref": "#/$defs/digest"}}, "allOf": [{"if": {"properties": {"status": {"const": "skipped"}}}, "then": {"required": ["skip_reason_code", "skip_reason_sha256"]}, "else": {"allOf": [{"not": {"required": ["skip_reason_code"]}}, {"not": {"required": ["skip_reason_sha256"]}}]}}]}},
    "outcomes_sha256": {"$ref": "#/$defs/digest"},
    "test_count": {"type": "integer", "minimum": 1},
    "passed_count": {"type": "integer", "minimum": 0},
    "failure_count": {"const": 0},
    "error_count": {"const": 0},
    "skip_count": {"type": "integer", "minimum": 0},
    "cell_certificate_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {"type": "object", "additionalProperties": false, "required": ["repository", "source_commit", "source_tree_sha256", "public_root_sha256", "public_manifest_sha256", "public_file_count"], "properties": {"repository": {"const": "https://github.com/saroo98/loom"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "source_tree_sha256": {"$ref": "#/$defs/digest"}, "public_root_sha256": {"$ref": "#/$defs/digest"}, "public_manifest_sha256": {"$ref": "#/$defs/digest"}, "public_file_count": {"type": "integer", "minimum": 1, "maximum": 8192}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["requested_label", "image_os", "image_version", "os", "os_release", "os_version", "architecture", "python_implementation", "python_version", "workflow_path", "workflow_digest", "action_manifest_digest", "event_name", "run_id", "run_attempt"], "properties": {"requested_label": {"type": "string", "minLength": 1, "maxLength": 128}, "image_os": {"type": "string", "minLength": 1, "maxLength": 128}, "image_version": {"type": "string", "minLength": 1, "maxLength": 128}, "os": {"type": "string", "minLength": 1, "maxLength": 128}, "os_release": {"type": "string", "minLength": 1, "maxLength": 128}, "os_version": {"type": "string", "minLength": 1, "maxLength": 128}, "architecture": {"type": "string", "minLength": 1, "maxLength": 128}, "python_implementation": {"type": "string", "minLength": 1, "maxLength": 128}, "python_version": {"type": "string", "minLength": 1, "maxLength": 128}, "workflow_path": {"type": "string", "minLength": 1, "maxLength": 128}, "workflow_digest": {"$ref": "#/$defs/digest"}, "action_manifest_digest": {"$ref": "#/$defs/digest"}, "event_name": {"type": "string", "minLength": 1, "maxLength": 128}, "run_id": {"type": "string", "minLength": 1, "maxLength": 128}, "run_attempt": {"type": "string", "minLength": 1, "maxLength": 128}}}
  }
}
