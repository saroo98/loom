{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/self-hosting-role-receipt-v2.schema.json",
  "title": "Verified Loom self-hosting subject authorization v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "expectation_sha256",
    "evaluation_epoch",
    "subject_bindings",
    "authorization_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "policy_id": {"const": "loom-self-hosting-subject-authority-v2"},
    "expectation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_epoch": {"type": "string", "format": "date-time"},
    "subject_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "subject_id", "subject_digest"],
        "properties": {
          "kind": {
            "enum": [
              "main-source",
              "candidate-source",
              "release-tag",
              "plugin-zip",
              "native-helper",
              "installed-runtime"
            ]
          },
          "subject_id": {"type": "string", "minLength": 1},
          "subject_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
