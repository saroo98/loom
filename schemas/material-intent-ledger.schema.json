{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/material-intent-ledger.schema.json",
  "title": "Derived material intent ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_sha256", "plan_contract_sha256",
    "derivation", "atoms", "ledger_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "plan_contract_sha256": {"$ref": "#/$defs/sha256"},
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "source", "authority_effect"],
      "properties": {
        "algorithm": {"const": "loom-material-intent-v1"},
        "source": {"const": "exact-request-spans-and-unique-work-order-token-overlap"},
        "authority_effect": {"const": "none"}
      }
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/atom"}
    },
    "ledger_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authority_id", "subject_digest"],
      "properties": {
        "kind": {"enum": ["plan-contract", "sealed-request"]},
        "authority_id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"},
        "subject_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id", "source", "normalized_meaning", "ambiguity",
        "consequence", "consumer", "decision_effect", "scope", "work_order",
        "authority", "content_digest"],
      "properties": {
        "atom_id": {"type": "string", "pattern": "^intent-[0-9]{3}$"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "subject_digest", "start", "end", "text_sha256"],
          "properties": {
            "kind": {"const": "sealed-request"},
            "subject_digest": {"$ref": "#/$defs/sha256"},
            "start": {"type": "integer", "minimum": 0},
            "end": {"type": "integer", "minimum": 1},
            "text_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "normalized_meaning": {"type": "string", "minLength": 1, "maxLength": 4096},
        "ambiguity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reasons"],
          "properties": {
            "state": {"enum": ["resolved", "unresolved"]},
            "reasons": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          }
        },
        "consequence": {"enum": ["ordinary", "material", "high", "critical"]},
        "consumer": {"type": "string", "minLength": 1, "maxLength": 160},
        "decision_effect": {"type": "string", "minLength": 1, "maxLength": 160},
        "scope": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "work_order": {
          "type": ["string", "null"],
          "pattern": "^WO-[0-9]{3,}$"
        },
        "authority": {"$ref": "#/$defs/authority"},
        "content_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
