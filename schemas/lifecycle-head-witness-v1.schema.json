{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/lifecycle-head-witness-v1.schema.json",
  "title": "Loom encrypted owner-side lifecycle head witness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "generation_id", "transition_id", "authoritative_sha256", "predecessor_witness_sha256", "witness_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/id"},
    "generation_id": {"$ref": "#/$defs/id"},
    "transition_id": {"$ref": "#/$defs/sha256"},
    "authoritative_sha256": {"$ref": "#/$defs/sha256"},
    "predecessor_witness_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "witness_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
