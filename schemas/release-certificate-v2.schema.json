{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/release-certificate-v2.schema.json",
  "title": "Exact current-candidate release certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "evidence_domain", "source_commit",
    "repository_source_tree_sha256", "public_root_sha256",
    "public_manifest_sha256", "public_file_count",
    "candidate_admission_sha256", "authority_mode",
    "authority_policy_sha256", "mechanism_manifest_sha256",
    "mechanism_qualification_sha256", "tag", "tag_receipt_sha256",
    "reproducibility", "reproducibility_receipt_sha256", "rollback",
    "rollback_receipt_sha256", "promotion", "promotion_receipt_sha256",
    "archive", "native_subjects", "release_certificate_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["release-ready", "draft-verified", "public-verified"]},
    "evidence_domain": {"const": "release-certificate-v2"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_source_tree_sha256": {"$ref": "#/$defs/digest"},
    "public_root_sha256": {"$ref": "#/$defs/digest"},
    "public_manifest_sha256": {"$ref": "#/$defs/digest"},
    "public_file_count": {"type": "integer", "minimum": 1, "maximum": 8192},
    "candidate_admission_sha256": {"$ref": "#/$defs/digest"},
    "authority_mode": {"enum": ["serial", "certificate"]},
    "authority_policy_sha256": {"$ref": "#/$defs/digest"},
    "mechanism_manifest_sha256": {"$ref": "#/$defs/digest"},
    "mechanism_qualification_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "tag": {"$ref": "#/$defs/tag"},
    "tag_receipt_sha256": {"$ref": "#/$defs/digest"},
    "reproducibility": {"$ref": "release-reproducibility-receipt-v1.schema.json"},
    "reproducibility_receipt_sha256": {"$ref": "#/$defs/digest"},
    "rollback": {"$ref": "release-rollback-evidence.schema.json"},
    "rollback_receipt_sha256": {"$ref": "#/$defs/digest"},
    "promotion": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "release-promotion-receipt-v1.schema.json"}
      ]
    },
    "promotion_receipt_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "archive": {
      "$ref": "release-reproducibility-receipt-v1.schema.json#/$defs/candidate"
    },
    "native_subjects": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "release-reproducibility-receipt-v1.schema.json#/$defs/native"
      }
    },
    "release_certificate_sha256": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"authority_mode": {"const": "serial"}}},
      "then": {"properties": {"mechanism_qualification_sha256": {"type": "null"}}},
      "else": {"properties": {"mechanism_qualification_sha256": {"$ref": "#/$defs/digest"}}}
    },
    {
      "if": {"properties": {"status": {"const": "release-ready"}}},
      "then": {
        "properties": {
          "promotion": {"type": "null"},
          "promotion_receipt_sha256": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "promotion": {"$ref": "release-promotion-receipt-v1.schema.json"},
          "promotion_receipt_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "tag", "commit", "tag_object_sha256",
        "signature_sha256", "signer_identity_sha256", "attestation_sha256",
        "signature_verified", "receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tag_object_sha256": {"$ref": "#/$defs/digest"},
        "signature_sha256": {"$ref": "#/$defs/digest"},
        "signer_identity_sha256": {"$ref": "#/$defs/digest"},
        "attestation_sha256": {"$ref": "#/$defs/digest"},
        "signature_verified": {"const": true},
        "receipt_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
