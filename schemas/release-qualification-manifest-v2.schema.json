{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/release-qualification-manifest-v2.schema.json",
  "title": "Generated repeated-qualification dependency manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "boundary_sha256",
    "entrypoints",
    "nodes",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "boundary_sha256": {"$ref": "#/$defs/digest"},
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/path"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "kind", "sha256", "dependencies"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "role": {
            "enum": [
              "mechanism-repeat",
              "shared-interface",
              "candidate-exact",
              "historical-compatibility"
            ]
          },
          "kind": {"enum": ["python", "workflow", "schema", "contract", "data"]},
          "sha256": {"$ref": "#/$defs/digest"},
          "dependencies": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "target"],
              "properties": {
                "kind": {
                  "enum": [
                    "python-import",
                    "process-invocation",
                    "schema-ref",
                    "declared-data",
                    "candidate-projection",
                    "workflow-call",
                    "workflow-script",
                    "external-action",
                    "data-set-member"
                  ]
                },
                "target": {"type": "string", "minLength": 1, "maxLength": 512}
              }
            }
          }
        }
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    }
  }
}
