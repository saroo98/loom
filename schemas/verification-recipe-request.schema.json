{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/verification-recipe-request.schema.json",
  "title": "Loom verification recipe compilation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_requests", "risk"],
  "properties": {
    "schema_version": {"const": 3},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "verification_requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "template_id", "target", "timeout_seconds"],
        "properties": {
          "section": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
          "target": {"type": "string", "minLength": 1, "maxLength": 512},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
        }
      }
    }
  }
}
