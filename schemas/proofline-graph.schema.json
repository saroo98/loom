{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/proofline-graph.schema.json",
  "title": "Authority-derived Proofline graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_sha256", "plan_contract_sha256",
    "assignment_digest", "authority_effect", "nodes", "edges", "graph_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "ledger_sha256": {"$ref": "#/$defs/sha256"},
    "plan_contract_sha256": {"$ref": "#/$defs/sha256"},
    "assignment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority_effect": {"const": "none"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/edge"}
    },
    "graph_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authority_id", "subject_digest"],
      "properties": {
        "kind": {"enum": ["plan-contract", "sealed-request"]},
        "authority_id": {"$ref": "#/$defs/id"},
        "subject_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "subject_digest",
        "governing_authority", "payload_sha256", "node_sha256"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "node_type": {"enum": ["acceptance", "authority", "current-fact",
          "intent-atom", "verification-medium", "work-order"]},
        "subject_digest": {"$ref": "#/$defs/sha256"},
        "governing_authority": {"$ref": "#/$defs/authority"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "node_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "edge_type", "source", "target",
        "governing_authority", "subject_digests", "edge_sha256"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/id"},
        "edge_type": {"enum": ["authorizes", "derived-from", "implements",
          "requires", "verifies"]},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "governing_authority": {"$ref": "#/$defs/authority"},
        "subject_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "edge_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
