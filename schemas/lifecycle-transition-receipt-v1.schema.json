{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/lifecycle-transition-receipt-v1.schema.json",
  "title": "Loom lifecycle transition and recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "generation_id", "command_id", "transition_id", "status", "source_authority_sha256", "target_authority_sha256", "source_witness_sha256", "target_witness_sha256", "observation", "durability_scope", "projection_status", "findings", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/id"},
    "generation_id": {"$ref": "#/$defs/id"},
    "command_id": {"$ref": "#/$defs/id"},
    "transition_id": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["prepared", "committed-projection-pending", "completed", "abandoned", "ambiguous", "failed"]},
    "source_authority_sha256": {"$ref": "#/$defs/sha256"},
    "target_authority_sha256": {"$ref": "#/$defs/sha256"},
    "source_witness_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "target_witness_sha256": {"$ref": "#/$defs/sha256"},
    "observation": {"enum": ["source", "target", "neither", "unavailable"]},
    "durability_scope": {"enum": ["process-crash-confirmed", "power-loss-confirmed", "power-loss-unconfirmed"]},
    "projection_status": {"enum": ["pending", "verified", "failed", "not-applicable"]},
    "findings": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
