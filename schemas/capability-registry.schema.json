{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/capability-registry.schema.json",
  "title": "Generated Loom capability registry v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "generated_by", "evidence_policy", "declarations_policy", "subject_bindings", "expected_subjects_sha256", "evaluated_at", "next_invalidation_at", "capabilities"],
  "properties": {
    "schema_version": {"const": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_by": {"const": "tools/loom_capability_registry.py"},
    "evidence_policy": {"const": "loom-evidence-policy-v1"},
    "declarations_policy": {
      "enum": ["loom-capability-declarations-v1", "legacy-read-only"]
    },
    "subject_bindings": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "evidence-envelope-v2.schema.json#/$defs/subjectBinding"}
    },
    "expected_subjects_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluated_at": {"type": ["string", "null"], "format": "date-time"},
    "next_invalidation_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}}
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "enforcement", "tests", "required_predicates", "required_subject_kinds", "evidence_ids", "limitations", "proof_binding"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"},
        "kind": {"enum": ["mechanical", "advisory"]},
        "status": {"enum": ["supported", "experimental", "stale-proof", "unsupported", "unverified"]},
        "enforcement": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "tests": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_predicates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_subject_kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["main-source", "candidate-source", "release-tag", "plugin-zip", "native-helper", "installed-runtime"]}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "proof_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_bindings", "evidence_graph_sha256", "files"],
          "properties": {
            "subject_bindings": {
              "type": "array",
              "maxItems": 64,
              "items": {"$ref": "evidence-envelope-v2.schema.json#/$defs/subjectBinding"}
            },
            "evidence_graph_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "files": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "path", "bytes", "sha256"],
                "properties": {
                  "role": {"enum": ["enforcement", "test"]},
                  "path": {"type": "string", "minLength": 1},
                  "bytes": {"type": "integer", "minimum": 0},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        }
      }
    }
  }
}
