{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/plan-presentation.schema.json",
  "title": "Deterministic review projection for one validated Loom plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "title",
    "summary",
    "tier",
    "preview_mode",
    "steps",
    "omitted_step_count",
    "expected_touch_paths",
    "assumptions",
    "decisions",
    "risks",
    "verification",
    "full_plan",
    "binding",
    "actions",
    "complete_inline_markdown",
    "presentation_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "format": {"const": "plan-presentation-v1"},
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "tier": {"enum": ["S", "M", "L"]},
    "preview_mode": {"enum": ["complete", "bounded", "frontier"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/step"}
    },
    "omitted_step_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "expected_touch_paths": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "assumptions": {"$ref": "#/$defs/boundedTextList"},
    "decisions": {"$ref": "#/$defs/boundedTextList"},
    "risks": {
      "type": "array",
      "maxItems": 1024,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "verification": {
      "type": "array",
      "maxItems": 1024,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "full_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^plans/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$",
          "maxLength": 256
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "project_id",
        "world_fingerprint",
        "plan_contract_hash",
        "pack_sha256",
        "revision",
        "relative_path",
        "manifest_sha256"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "world_fingerprint": {"$ref": "#/$defs/sha256"},
        "plan_contract_hash": {"$ref": "#/$defs/sha256"},
        "pack_sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "relative_path": {
          "type": "string",
          "pattern": "^plans/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$",
          "maxLength": 256
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revise", "start"],
      "properties": {
        "revise": {"$ref": "#/$defs/action"},
        "start": {"$ref": "#/$defs/action"}
      }
    },
    "complete_inline_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 196608
    },
    "presentation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"tier": {"const": "S"}}},
      "then": {
        "properties": {
          "preview_mode": {"const": "complete"},
          "omitted_step_count": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"tier": {"const": "M"}}},
      "then": {
        "properties": {
          "preview_mode": {"const": "bounded"},
          "steps": {"maxItems": 5}
        }
      }
    },
    {
      "if": {"properties": {"tier": {"const": "L"}}},
      "then": {
        "properties": {
          "preview_mode": {"const": "frontier"},
          "steps": {"maxItems": 5}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundedTextList": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "tasks",
        "acceptance",
        "negative_acceptance",
        "out_of_scope",
        "escalation",
        "touches",
        "depends_on"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^WO-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 500},
        "tasks": {"$ref": "#/$defs/boundedTextList"},
        "acceptance": {"$ref": "#/$defs/boundedTextList"},
        "negative_acceptance": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "out_of_scope": {"$ref": "#/$defs/boundedTextList"},
        "escalation": {"$ref": "#/$defs/boundedTextList"},
        "touches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "depends_on": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^WO-[0-9]{3,}$"}
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "instruction"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
