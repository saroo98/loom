{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom/schemas/suite-shard-plan-v1.schema.json",
  "title": "Deterministic module-level release-suite shard plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_sha256", "policy_sha256", "timing_profile_sha256", "logical_cpu_count", "max_parallel_workers", "shards", "plan_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timing_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_cpu_count": {"type": "integer", "minimum": 1, "maximum": 1024},
    "max_parallel_workers": {"type": "integer", "minimum": 1, "maximum": 4096},
    "shards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shard_id", "exclusive", "estimated_microseconds", "modules"],
        "properties": {
          "shard_id": {"type": "string", "pattern": "^(exclusive|general-[0-9]{3})$"},
          "exclusive": {"type": "boolean"},
          "estimated_microseconds": {"type": "integer", "minimum": 1},
          "modules": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "pattern": "^test_[A-Za-z0-9_]+$"}}
        }
      }
    },
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
